<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../templates/head'); %>
    <link rel="stylesheet" href="/style/style.css">
</head>

<body>
    <%- include('../templates/header'); %>

    <main class="flex min-h-[calc(100vh-73px)] items-center justify-center p-4">
        <div id="form-modal"
            class="w-full max-w-sm rounded-3xl p-6 sm:p-8 relative border border-gray-100 shadow-xl bg-white/3 backdrop-blur-md">

            <div class="flex items-center gap-3 mb-6">
                <div class="pokeball"></div>
                <h3 class="font-display text-2xl font-bold">Cadastrar</h3>
            </div>

            <form id="cad-form" enctype="multipart/form-data" method="post" action="/cadastro" class="flex flex-col gap-4">
                <label class="text-sm font-medium block">
                    Nome
                    <input name="nome" id="nome" type="text" required placeholder="Cynthia"
                        class="field w-full mt-1 rounded-xl px-4 py-3 border border-gray-300 focus:outline-none">
                </label>
                <label class="text-sm font-medium block">
                    Nome de usuário
                    <input name="nome_usuario" id="nome_usuario" type="text" required placeholder="Campeã de Sinnoh"
                        class="field w-full mt-1 rounded-xl px-4 py-3 border border-gray-300 focus:outline-none">
                </label>
                <label class="text-sm font-medium block">
                    E-mail
                    <input name="email" id="email" type="email" required placeholder="voce@email.com"
                    class="field w-full mt-1 rounded-xl px-4 py-3 border border-gray-300 focus:outline-none">
                </label>
                <label for="tipo_favorito" class="text-sm font-medium block">
                    Tipo Pokémon favorito

                    <select name="tipo_favorito" id="tipo_favorito" required
                        class="field w-full mt-1 rounded-xl px-4 py-3 border border-gray-300 focus:outline-none">
                        <option value="">Selecione um tipo</option>

                        <% tipos.forEach(tipo=> { %>
                            <option value="<%= tipo.id_tipo %>">
                                <%= tipo.nome_tipo %>
                            </option>
                            <% }) %>
                    </select>
                </label>
                <label for="imagem" class="text-sm font-medium block">
                    Foto de perfil

                    <input type="file" name="imagem" id="imagem" accept="image/png, image/jpeg, image/webp"
                        class="field w-full mt-1 rounded-xl px-4 py-3 border border-gray-300">
                </label>
                <label class="block text-sm font-medium text-gray-700">
                    Senha
                    <div class="relative mt-1">
                        <input name="senha" id="senha" type="password" id="senha" required placeholder="••••••••"
                            class="field w-full rounded-xl px-4 py-3 pr-12 border border-gray-300 focus:outline-none">

                        <button type="button" id="btn-toggle"
                            class="absolute inset-y-0 right-0 flex items-center pr-4 text-gray-500 hover:text-gray-700 focus:outline-none">
                            <i id="icone-olho" class="fas fa-eye"></i>
                        </button>
                    </div>
                </label>
                <button type="submit"
                    class="text-white rounded-xl font-bold py-3 mt-2 flex items-center justify-center gap-2 cursor-pointer duration-200 hover:opacity-90"
                    style="background: var(--pokedex-red)">
                    <i class="fa-solid fa-right-to-bracket"></i> Entrar
                </button>
                <a href="login.ejs" class="text-xs text-center underline" style="color: var(--text-soft)">Já tem? Faça
                    seu login!</a>
            </form>
        </div>
    </main>

    <script src="script/script_index.js" defer></script>
</body>

</html>