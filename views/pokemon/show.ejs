<!DOCTYPE html>
<html lang="pt-br" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PokeFav · Time principal de Kanto</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>
        :root {
            --bg-app: #0b0d13;
            --bg-panel: #12151d;
            --bg-panel-2: #191d27;
            --bg-panel-3: #1f2430;
            --line: rgba(255, 255, 255, .09);
            --text: #eef1f6;
            --text-soft: #97a0b2;
            --pokedex-red: #e3350d;
            --pokedex-red-dim: rgba(227, 53, 13, .14);
            --pokedex-gold: #ffcb05;
        }
        * { box-sizing: border-box; }
        body { background: var(--bg-app); color: var(--text); font-family: 'Inter', system-ui, sans-serif; }
        .font-display { font-family: 'Poppins', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        .pokeball {
            width: 30px; height: 30px; border-radius: 50%;
            background: linear-gradient(var(--bg-app) 0 0) content-box,
                conic-gradient(var(--pokedex-red) 0 50%, #f4f4f4 50% 100%);
            border: 2px solid #14161c; position: relative; flex-shrink: 0;
        }
        .pokeball::after { content: ''; position: absolute; inset: 0; margin: auto; width: 9px; height: 9px; border-radius: 50%; background: #14161c; border: 2px solid var(--text-soft); }
        .pokeball::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: #14161c; transform: translateY(-1px); z-index: 1; }

        .icon-btn { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid var(--line); color: var(--text-soft); background: var(--bg-panel-2); transition: .2s; }
        .icon-btn:hover { color: var(--text); border-color: var(--pokedex-gold); }

        .header-shell { background: rgba(11, 13, 19, .78); }
        .nav-link { color: var(--text-soft); }
        .nav-link:hover, .nav-link.active { color: var(--text); }
        .nav-link.active { background: var(--bg-panel-2); }

        .panel { background: var(--bg-panel); border: 1px solid var(--line); }

        .btn-primary { background: var(--pokedex-red); color: #fff; font-weight: 700; transition: .2s; box-shadow: 0 8px 20px -8px rgba(227, 53, 13, .55); }
        .btn-primary:hover { filter: brightness(1.08); transform: translateY(-1px); }
        .btn-ghost { background: var(--bg-panel-2); border: 1px solid var(--line); color: var(--text); transition: .2s; }
        .btn-ghost:hover { border-color: var(--pokedex-gold); }

        .type-pill { font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; padding: 3px 9px; border-radius: 999px; color: #fff; font-weight: 500; }
        .type-chip {
            font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em;
            padding: 6px 12px; border-radius: 10px; color: #fff; font-weight: 500; display: flex; align-items: center; gap: 6px;
        }

        .hero-cover {
            background:
                radial-gradient(circle at 15% 20%, rgba(255,255,255,.08), transparent 40%),
                linear-gradient(135deg, var(--pokedex-red), #7a1a08 65%, #14161c);
        }

        .poke-card { background: var(--bg-panel); border: 1px solid var(--line); transition: .2s; }
        .poke-card:hover { border-color: var(--pokedex-gold); transform: translateY(-3px); box-shadow: 0 14px 26px -14px rgba(0,0,0,.6); }
        .poke-card .sprite-wrap { background: radial-gradient(circle, var(--bg-panel-3) 0%, var(--bg-panel-2) 100%); }

        .id-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--text-soft); }

        @media (max-width: 1023px) { #mobile-menu { display: none; } #mobile-menu.open { display: block; } }
        @media (min-width: 1024px) { .desktop-nav { display: block; } #mobile-menu, #hamburger-btn { display: none; } }
        @media (max-width: 1023px) { .desktop-nav { display: none; } }
    </style>
</head>

<body class="min-h-screen">

    <!-- ============ HEADER ============ -->
    <header class="header-shell sticky top-0 z-40 backdrop-blur-xl border-b" style="border-color: var(--line)">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex justify-between items-center gap-3">
            <a href="index.ejs" class="group flex items-center gap-3 min-w-0">
                <div class="pokeball"></div>
                <div class="min-w-0">
                    <h1 class="font-display font-extrabold text-xl sm:text-2xl tracking-tight leading-none truncate">
                        Poke<span style="color: var(--pokedex-red)">Fav</span>
                    </h1>
                    <p class="font-mono text-[10px] uppercase tracking-[0.2em]" style="color: var(--text-soft)">Pokédex pessoal</p>
                </div>
            </a>
            <nav class="desktop-nav">
                <ul class="flex items-center gap-1 text-sm font-medium">
                    <li><a href="listagens.ejs" class="nav-link active flex items-center gap-2 px-4 py-2 rounded-full duration-200"><i class="fa-solid fa-list"></i> Minhas listagens</a></li>
                    <li><a href="index.ejs#tipos" class="nav-link flex items-center gap-2 px-4 py-2 rounded-full hover:bg-white/5 duration-200"><i class="fa-solid fa-layer-group"></i> Tipos</a></li>
                </ul>
            </nav>
            <div class="flex items-center gap-2 sm:gap-3">
                <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png" alt="Avatar" class="w-9 h-9 rounded-full border" style="border-color: var(--line); background: var(--bg-panel-2)">
                <button id="hamburger-btn" class="hamburger-btn icon-btn" aria-label="Abrir menu"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
        <div id="mobile-menu" class="lg:hidden border-t" style="border-color: var(--line)">
            <ul class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-1 text-sm font-medium">
                <li><a href="listagens.ejs" class="nav-link flex items-center gap-2 px-3 py-3 rounded-xl hover:bg-white/5"><i class="fa-solid fa-list"></i> Minhas listagens</a></li>
                <li><a href="index.ejs#tipos" class="nav-link flex items-center gap-2 px-3 py-3 rounded-xl hover:bg-white/5"><i class="fa-solid fa-layer-group"></i> Tipos</a></li>
            </ul>
        </div>
    </header>

    <!-- ============ HERO DA LISTAGEM ============ -->
    <section class="hero-cover">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-12 sm:pt-14 sm:pb-16">
            <a href="listagens.ejs" class="font-mono text-xs uppercase tracking-[0.2em] flex items-center gap-2 mb-6 w-fit text-white/70 hover:text-white duration-200">
                <i class="fa-solid fa-arrow-left"></i> Minhas listagens
            </a>

            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
                <div>
                    <span class="font-mono text-xs uppercase tracking-[0.25em] px-3 py-1 rounded-full bg-white/10 text-white/90">
                        <i class="fa-solid fa-globe mr-1"></i> Pública
                    </span>
                    <h2 class="font-display font-black text-3xl sm:text-5xl text-white mt-4 leading-tight">Time principal de Kanto</h2>
                    <p class="mt-3 max-w-xl text-white/80">Os Pokémons que eu levaria pra qualquer batalha em Kanto, sem pensar duas vezes.</p>

                    <div class="flex items-center gap-3 mt-5">
                        <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png" class="w-8 h-8 rounded-full bg-white/10 p-1" alt="Autor">
                        <span class="text-sm text-white/70 font-mono">por <span class="text-white font-semibold">ash.ketchum</span> · atualizado hoje</span>
                    </div>
                </div>

                <div class="flex gap-3">
                    <a href="listagem-editar.html" class="btn-ghost px-5 py-3 rounded-xl font-bold flex items-center gap-2 bg-white/10 border-white/20 text-white hover:border-white/50">
                        <i class="fa-solid fa-pen"></i> Editar
                    </a>
                    <button id="share-btn" class="px-5 py-3 rounded-xl font-bold flex items-center gap-2 text-white" style="background: rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.2)">
                        <i class="fa-solid fa-share-nodes"></i> Compartilhar
                    </button>
                </div>
            </div>
        </div>
    </section>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14 space-y-10">

        <!-- resumo / stats -->
        <section class="grid sm:grid-cols-3 gap-4">
            <div class="panel rounded-2xl p-5 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center" style="background: var(--pokedex-red-dim); color: var(--pokedex-red)">
                    <i class="fa-solid fa-paw"></i>
                </div>
                <div>
                    <p class="font-display font-bold text-2xl leading-none">4</p>
                    <p class="text-xs mt-1" style="color: var(--text-soft)">Pokémons na listagem</p>
                </div>
            </div>
            <div class="panel rounded-2xl p-5">
                <p class="text-xs mb-3 font-mono uppercase tracking-wide" style="color: var(--text-soft)">Tipos presentes</p>
                <div id="type-summary" class="flex flex-wrap gap-2"></div>
            </div>
            <div class="panel rounded-2xl p-5 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center" style="background: rgba(255,203,5,.12); color: var(--pokedex-gold)">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <div>
                    <p class="font-display font-bold text-2xl leading-none">128</p>
                    <p class="text-xs mt-1" style="color: var(--text-soft)">Curtidas da comunidade</p>
                </div>
            </div>
        </section>

        <!-- grid de pokemons -->
        <section>
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-display text-xl sm:text-2xl font-bold">Pokémons desta listagem</h3>
                <a href="listagem-editar.html" class="text-sm font-semibold flex items-center gap-2" style="color: var(--pokedex-gold)">
                    <i class="fa-solid fa-plus"></i> Adicionar
                </a>
            </div>

            <ul id="poke-grid" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5"></ul>
        </section>
    </main>

    <footer class="text-center text-sm py-10 border-t" style="color: var(--text-soft); border-color: var(--line)">
        Dados fornecidos por <a href="https://pokeapi.co" target="_blank" style="color: var(--pokedex-gold)" class="hover:underline">PokéAPI</a> ·
        Feito com <i class="fa-solid fa-heart" style="color: var(--pokedex-red)"></i> por PokeFav
    </footer>

    <script>
        const TYPE_COLORS = {
            normal:'#A8A878', fire:'#F08030', water:'#6890F0', electric:'#F8D030',
            grass:'#78C850', ice:'#98D8D8', fighting:'#C03028', poison:'#A040A0',
            ground:'#E0C068', flying:'#A890F0', psychic:'#F85888', bug:'#A8B820',
            rock:'#B8A038', ghost:'#705898', dragon:'#7038F8', dark:'#705848',
            steel:'#B8B8D0', fairy:'#EE99AC'
        };

        const LISTING = [
            { id: 6,   name: 'Charizard', types: ['fire','flying'] },
            { id: 25,  name: 'Pikachu',   types: ['electric'] },
            { id: 143, name: 'Snorlax',   types: ['normal'] },
            { id: 150, name: 'Mewtwo',    types: ['psychic'] },
        ];

        const sprite = (id) => `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
        const typePill = (t) => `<span class="type-pill" style="background:${TYPE_COLORS[t]}">${t}</span>`;

        // grid de pokemons
        document.getElementById('poke-grid').innerHTML = LISTING.map(p => `
            <li class="poke-card rounded-2xl p-4 flex flex-col items-center text-center relative">
                <span class="id-tag absolute top-4 left-4">#${String(p.id).padStart(3,'0')}</span>
                <div class="sprite-wrap w-full rounded-xl flex items-center justify-center py-4 mb-3">
                    <img src="${sprite(p.id)}" alt="${p.name}" class="w-24 h-24 object-contain drop-shadow-lg">
                </div>
                <h4 class="font-display font-bold text-base">${p.name}</h4>
                <div class="flex gap-1.5 mt-2 flex-wrap justify-center">${p.types.map(typePill).join('')}</div>
            </li>
        `).join('');

        // resumo de tipos presentes
        const typeCounts = {};
        LISTING.forEach(p => p.types.forEach(t => { typeCounts[t] = (typeCounts[t] || 0) + 1; }));
        document.getElementById('type-summary').innerHTML = Object.entries(typeCounts).map(([t, c]) => `
            <span class="type-chip" style="background:${TYPE_COLORS[t]}">${t} <span style="opacity:.8">· ${c}</span></span>
        `).join('');

        document.getElementById('share-btn').addEventListener('click', () => {
            alert('Protótipo: aqui o link da listagem seria copiado.');
        });

        document.getElementById('hamburger-btn').addEventListener('click', () => {
            document.getElementById('mobile-menu').classList.toggle('open');
        });
    </script>
</body>
</html>
